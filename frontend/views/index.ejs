            <!--Seccion Testimonios-->
            <section class="py-5 bg-light">
                <div class="container">
                    <h2 class="text-center mb-5">Lo que dicen nuestros clientes</h2>
                    <div class="row">
                        <!-- Testimonio 1 -->
                        <div class="col-md-4 mb-4">
                            <div class="card p-4 h-100">
                                <div class="d-flex mb-3">
                                    <i class="bi bi-person"></i>
                                    <div>
                                        <h5 class="mb-0">Ana Pérez</h5>
                                        <div class="text-warning">
                                            ★★★★★
                                        </div>
                                    </div>
                                </div>
                                <p class="mb-0">"¡La mejor laptop que he tenido! Entrega rápida y buen soporte."</p>
                            </div>
                        </div>
                        <!-- Testimonio 2 -->
                        <div class="col-md-4 mb-4">
                            <div class="card p-4 h-100">
                                <div class="d-flex mb-3">
                                    <i class="bi bi-person"></i>
                                    <div>
                                        <h5 class="mb-0">Carlos Gómez</h5>
