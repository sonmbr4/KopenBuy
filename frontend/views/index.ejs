<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tienda de tecnología con los mejores productos al mejor precio">
    <title>Kopen Buy - Tecnología de Última Generación</title>
    <link rel="stylesheet" href="/CSS/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <%- include('./partials/header.ejs'); %>
        <main class="landing-container">
            <!-- Sección Banner -->
            <section class="product-carousel mb-5">
                <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
                    <!--Indicadores-->
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0"
                            class="active"></button>
                        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
                        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button>
                    </div>

                    <!--Slide-->
                    <div class="carousel-inner rounded-3 overflow-hidden">
                        <!--Oferta 1-->
                        <div class="carousel-item active">
                            <div class="d-block w-100 bg-success bg-opacity-10 p-5" style="height: 400px;">
                                <div class="container h-100">
                                    <div class="row h-100 align-items-center">
                                        <div class="col-md-6">
                                            <span class="badge bg-danger mb-3">OFERTA LIMITADA</span>
                                            <h2 class="display-5 fw-bold mb-3">Control Gamer</h2>
                                            <p class="lead mb-4">hasta 30% de descuento en todos los dispositivos Gamer
                                            </p>
                                            <a href="#" class="btn btn-success btn-lg px-4">Ver oferta</a>
                                        </div>
                                        <div class="col-md-3 d-none d-md-block">
                                            <img src="assets/imagenes/Control-Gamer.png" class="img-fluid" alt="Control"
                                                loading="lazy">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Oferta 2-->
                        <div class="carousel-item ">
                            <div class="d-block w-100 bg-success bg-opacity-10 p-5" style="height: 400px;">
                                <div class="container h-100">
                                    <div class="row h-100 align-items-center">
                                        <div class="col-md-6">
                                            <span class="badge bg-danger mb-3">Nuevos Productos</span>
                                            <h2 class="display-5 fw-bold mb-3">Audifonos</h2>
                                            <p class="lead mb-4">Nuevos Auriculares bluethoot</p>
                                            <a href="#" class="btn btn-success btn-lg px-4">Ver Productos</a>
                                        </div>
                                        <div class="col-md-3 d-none d-md-block">
                                            <img src="assets/imagenes/Auriculares.png" class="img-fluid" alt="Control"
                                                loading="lazy">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--oferta 3-->
                        <div class="carousel-item ">
                            <div class="d-block w-100 bg-success bg-opacity-10 p-5" style="height: 400px;">
                                <div class="container h-100">
                                    <div class="row h-100 align-items-center">
                                        <div class="col-md-6">
                                            <span class="badge bg-danger mb-3">OFERTA LIMITADA</span>
                                            <h2 class="display-5 fw-bold mb-3">Laptops Gamer</h2>
                                            <p class="lead mb-4">hasta 30% de descuento en todos los dispositivos Gamer
                                            </p>
                                            <a href="#" class="btn btn-success btn-lg px-4">Ver oferta</a>
                                        </div>
                                        <div class="col-md-3 d-none d-md-block">
                                            <img src="assets/imagenes/Laptop-Gamer-Carousel.png" class="img-fluid"
                                                alt="Control" loading="lazy">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--Controles-->
                        <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel"
                            data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel"
                            data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    </div>
                </div>


            </section>

            <!-- Sección Categorías -->
            <section class="py-5 bg-white" id="categorias">
                <div class="container">
                    <h2 class="text-center mb-5">Categorías</h2>
                    <div class="row g-4">
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Laptops</h5>
                                </div>
                                <a href="#laptops" class="stretched-link"></a>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Smartphones</h5>
                                </div>
                                <a href="#smartphones" class="stretched-link"></a>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Audio</h5>
                                </div>
                                <a href="#audio" class="stretched-link"></a>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Gaming</h5>
                                </div>
                                <a href="#gaming" class="stretched-link"></a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!--Seccion Productos Destacados-->
            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll">Productos Destacados</h2>
                    <div class="row g-4">
                        <% if (productosDestacados && productosDestacados.length> 0) { %>
                            <% productosDestacados.forEach((producto, index)=> { %>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card product-card fade-in-scroll"
                                        style="transition-delay: <%= 0.1 * (index + 1) %>s;">
                                        <% if (producto.image) { %>
                                            <img src="<%= producto.image %>" class="card-img-top product-image"
                                                alt="<%= producto.name %>" loading="lazy">
                                            <% } else { %>
                                                <img src="/images/placeholder-product.jpg"
                                                    class="card-img-top product-image" alt="Imagen no disponible"
                                                    loading="lazy">
                                                <% } %>
                                                    <div class="card-body">
                                                        <h5 class="card-title">
                                                            <%= producto.name %>
                                                        </h5>
                                                        <% if (producto.category) { %>
                                                            <p class="text-primary mb-2"><small>
                                                                    <%= producto.category %>
                                                                </small></p>
                                                            <% } %>
                                                                <p class="card-text text-muted">
                                                                    <%= producto.description
                                                                        || 'Sin descripción disponible' %>
                                                                </p>
                                                                <div
                                                                    class="d-flex justify-content-between align-items-center">
                                                                    <span
                                                                        class="badge <%= producto.stock <= 0 ? 'bg-danger' : (producto.stock < 10 ? 'bg-warning' : 'bg-success') %>">
                                                                        <%= producto.stock <=0 ? 'Agotado' :
                                                                            (producto.stock < 10 ? 'Casi Agotado'
                                                                            : 'En Stock' ) %>
                                                                    </span>
                                                                    <span class="fw-bold">$<%= producto.price ?
                                                                            producto.price.toLocaleString() : '0' %>
                                                                    </span>
                                                                </div>
                                                    </div>
                                                    <div class="card-footer bg-white border-0 d-flex flex-column gap-2">
                                                        <a href="/productos/<%= producto._id %>" class="btn btn-outline-primary w-100">Ver Detalles</a>
                                                        <!-- Botón de Agregar al Carrito (solo para usuarios logueados) -->
                                                        <button class="btn btn-success add-to-cart-btn auth-only"
                                                            style="display: none;" data-product-id="<%= producto._id %>">
                                                            🛒 Agregar al Carrito
                                                        </button>
                                                    </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="col-12 text-center">
                                            <p>No hay productos destacados disponibles en este momento.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </section>


            <!--Seccion Computadoras-->
            <section class="py-5 product-section">
