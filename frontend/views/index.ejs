<!--
  Vista: Home (index.ejs)
  Propósito: Página principal que muestra categorías y listados de productos destacados y por secciones.
  Incluye: header/footer parciales, estilos y scripts de frontend.
-->
<!DOCTYPE html>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tienda de tecnología con los mejores productos al mejor precio">
    <title>Kopen Buy - Tecnología de Última Generación</title>
    <link rel="stylesheet" href="/CSS/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <%- include('./partials/header.ejs'); %>
        <main class="landing-container">

            <!-- Sección Categorías -->
            <section class="py-5 bg-white" id="categorias">
                <div class="container">
                    <h2 class="text-center mb-5">Categorías</h2>
                    <div class="row g-4">
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Portátiles</h5>
                                </div>
                                <a href="#laptops" class="stretched-link"></a>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Teléfonos</h5>
                                </div>
                                <a href="#telefonos" class="stretched-link"></a>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Audio</h5>
                                </div>
                                <a href="#audio" class="stretched-link"></a>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title">Juegos</h5>
                                </div>
                                <a href="#juegos" class="stretched-link"></a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!-- Sección Productos Destacados -->
            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll">Productos Destacados</h2>
                    <div class="row g-4">
                        <% if (productosDestacados && productosDestacados.length> 0) { %>
                            <% productosDestacados.forEach((producto, index)=> { %>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card product-card fade-in-scroll">
                                        <% if (producto.image) { %>
                                            <img src="/uploads/<%= producto.image.includes('/') ? producto.image.split('/').pop() : producto.image %>"
                                                alt="<%= producto.name %>" class="card-img-top"
                                                style="height: 200px; object-fit: cover;"
                                                onerror="this.onerror=null; this.src='/assets/imagenes/placeholder-image.svg'">
                                            <% } else { %>
                                                <img src="/assets/imagenes/placeholder-image.svg" class="card-img-top"
                                                    alt="Imagen no disponible"
                                                    style="height: 200px; object-fit: contain;" loading="lazy">
                                                <% } %>

                                                    <div class="card-body">
                                                        <h5 class="card-title">
                                                            <%= producto.name %>
                                                        </h5>

                                                        <% if (producto.category) { %>
                                                            <p class="text-primary mb-2">
                                                                <small>
                                                                    <%= producto.category %>
                                                                </small>
                                                            </p>
                                                            <% } %>

                                                                <p class="card-text text-muted">
                                                                    <%= producto.description ?
                                                                        (producto.description.length> 60 ?
                                                                        producto.description.substring(0, 60) + '...' :
                                                                        producto.description) :
                                                                        'Sin descripción disponible' %>
                                                                </p>

                                                                <div
                                                                    class="d-flex justify-content-between align-items-center">
                                                                    <span class="badge <%= producto.stock <= 0 ? 'bg-danger' : 
                                        (producto.stock < 10 ? 'bg-warning' : 'bg-success') %>">
                                                                        <%= producto.stock <=0 ? 'Agotado' :
                                                                            (producto.stock < 10 ? 'Casi Agotado'
                                                                            : 'En Stock' ) %>
                                                                    </span>
                                                                    <span class="fw-bold">$<%= producto.price ?
                                                                            producto.price.toLocaleString() : '0' %>
                                                                            </span>
                                                                </div>
                                                    </div>

                                                    <div class="card-footer bg-white border-0 d-flex flex-column gap-2">
                                                        <a href="/productos/<%= producto._id %>"
                                                            class="btn btn-outline-primary w-100">Ver Detalles</a>
                                                        <button class="btn btn-success add-to-cart-btn auth-only"
                                                            style="display: none;"
                                                            data-product-id="<%= producto._id %>">
                                                            🛒 Agregar al Carrito
                                                        </button>
                                                    </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="col-12 text-center">
                                            <p>No hay productos destacados disponibles en este momento.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </section>


            <!--Seccion Computadoras-->
            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll" id="laptops">Computadoras</h2>
                    <div class="row g-4">
                        <% if (computerProducts && computerProducts.length> 0) { %>
                            <% computerProducts.forEach((producto, index)=> { %>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card product-card fade-in-scroll">
                                        <% if (producto.image) { %>
                                            <img src="/uploads/<%= producto.image.includes('/') ? producto.image.split('/').pop() : producto.image %>"
                                                alt="<%= producto.name %>" class="card-img-top"
                                                style="height: 200px; object-fit: cover;"
                                                onerror="this.onerror=null; this.src='/assets/imagenes/placeholder-image.svg'">
                                            <% } else { %>
                                                <img src="/assets/imagenes/placeholder-image.svg"
                                                    class="card-img-top product-image" alt="Imagen no disponible"
                                                    loading="lazy" onerror="handleImageError(this)">
                                                <% } %>
                                                    <div class="card-body">
                                                        <h5 class="card-title">
                                                            <%= producto.name %>
                                                        </h5>
                                                        <% if (producto.category) { %>
                                                            <p class="text-primary mb-2"><small>
                                                                    <%= producto.category %>
                                                                </small></p>
                                                            <% } %>
                                                                <p class="card-text text-muted">
                                                                    <%= producto.description
                                                                        || 'Sin descripción disponible' %>
                                                                </p>
                                                                <div
                                                                    class="d-flex justify-content-between align-items-center">
                                                                    <span
                                                                        class="badge <%= producto.stock <= 0 ? 'bg-danger' : (producto.stock < 10 ? 'bg-warning' : 'bg-success') %>">
                                                                        <%= producto.stock <=0 ? 'Agotado' :
                                                                            (producto.stock < 10 ? 'Casi Agotado'
                                                                            : 'En Stock' ) %>
                                                                    </span>
                                                                    <span class="fw-bold">$<%= producto.price ?
                                                                            producto.price.toLocaleString() : '0' %>
                                                                    </span>
                                                                </div>
                                                    </div>
                                                    <div class="card-footer bg-white border-0 d-flex flex-column gap-2">
                                                        <a href="/productos/<%= producto._id %>"
                                                            class="btn btn-outline-primary w-100">Ver Detalles</a>
                                                        <!-- Botón de Agregar al Carrito (solo para usuarios logueados) -->
                                                        <button class="btn btn-success add-to-cart-btn auth-only"
                                                            style="display: none;"
                                                            data-product-id="<%= producto._id %>">
                                                            🛒 Agregar al Carrito
                                                        </button>
                                                    </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="col-12 text-center">
                                            <p>No hay computadoras disponibles en este momento.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </section>


            <!--Seccion Telefonos-->
            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll" id="telefonos">Teléfonos</h2>
