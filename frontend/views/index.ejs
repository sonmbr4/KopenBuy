                                                        <!-- Botón de Agregar al Carrito (solo para usuarios logueados) -->
                                                        <button class="btn btn-success add-to-cart-btn auth-only"
                                                            style="display: none;"
                                                            data-product-id="<%= producto._id %>">
                                                            🛒 Agregar al Carrito
                                                        </button>
                                                    </div>
                                    </div>
                                </div>
                                <% }); %>

                                    <% } else { %>
                                        <div class="col-12 text-center">
                                            <p>No hay teléfonos disponibles en este momento.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </section>

            <!--Seccion Audio-->
            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll" id="audio">Audio</h2>
                    <div class="row g-4">
                        <% if (audioProducts && audioProducts.length> 0) { %>
                            <% audioProducts.forEach((producto, index)=> { %>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card product-card fade-in-scroll">
