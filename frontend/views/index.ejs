                                                    </div>
                                    </div>
                                </div>
                                <% }); %>

                                    <% } else { %>
                                        <div class="col-12 text-center">
                                            <p>No hay nada relacionado con audio disponibles en este momento.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </section>

            <!--Seccion Gaming-->

            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll" id="juegos">Juegos</h2>
                    <div class="row g-4">
                        <% if (gamingProducts && gamingProducts.length> 0) { %>
                            <% gamingProducts.forEach((producto, index)=> { %>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card product-card fade-in-scroll">
                                        <% if (producto.image) { %>
                                            <img src="/uploads/<%= producto.image.includes('/') ? producto.image.split('/').pop() : producto.image %>"
