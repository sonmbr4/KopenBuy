<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tienda de tecnología con los mejores productos al mejor precio">
    <title>Kopen Buy - Tecnología de Última Generación</title>
    <link rel="stylesheet" href="/CSS/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <%- include('./partials/header.ejs'); %>
    <main class="container my-5">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">
                    <i class="bi bi-box-seam me-2"></i>Mis Pedidos
                </h1>
                
                <% if (pedidos && pedidos.length > 0) { %>
                    <div class="list-group">
                        <% pedidos.forEach(pedido => { %>
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">
                                            <i class="bi bi-receipt me-2"></i>Pedido #<%= pedido.numeroPedido || 'N/A' %>
                                            <% if (pedido.factura && pedido.factura.numeroFactura) { %>
                                                <small class="text-muted ms-2">
                                                    (Factura: <%= pedido.factura.numeroFactura %>)
                                                </small>
                                            <% } %>
                                        </h5>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            <%= typeof pedido.fecha === 'string' ? pedido.fecha : pedido.fecha.toLocaleDateString('es-ES', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                hour: '2-digit',
                                                minute: '2-digit'
                                            }) %>
                                        </small>
                                    </div>
                                    <span class="badge rounded-pill bg-<%= 
                                        pedido.estado === 'entregado' ? 'success' : 
                                        pedido.estado === 'enviado' ? 'warning' : 
                                        pedido.estado === 'confirmado' ? 'primary' :
                                        pedido.estado === 'cancelado' ? 'danger' :
                                        pedido.estado === 'pendiente' ? 'secondary' : 
                                        'secondary' 
                                    %> text-capitalize">
                                        <i class="bi <%= 
                                            pedido.estado === 'entregado' ? 'bi-check-circle' : 
                                            pedido.estado === 'enviado' ? 'bi-truck' : 
                                            pedido.estado === 'confirmado' ? 'bi-check2-square' :
                                            pedido.estado === 'cancelado' ? 'bi-x-circle' :
                                            pedido.estado === 'pendiente' ? 'bi-hourglass-split' : 
                                            'bi-question-circle' 
                                        %> me-1"></i>
                                        <%=pedido.estado || 'En proceso' %>
                                    </span>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <h6 class="d-flex align-items-center">
                                                <i class="bi bi-box-seam me-2"></i>Productos
                                                <span class="badge bg-secondary ms-2"><%= pedido.productos.length %></span>
                                            </h6>
                                            <div class="table-responsive">
                                                <table class="table table-hover">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Producto</th>
                                                            <th class="text-center">Cantidad</th>
                                                            <th class="text-end">Precio</th>
                                                            <th class="text-end">Subtotal</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% pedido.productos.forEach(producto => { %>
                                                            <tr>
                                                                <td>
                                                                    <div class="d-flex align-items-center">
                                                                        <% if (producto.producto && producto.producto.imagen) { %>
                                                                            <img src="/uploads/<%= producto.producto.imagen %>" 
                                                                                 alt="<%= producto.nombre %>" 
                                                                                 class="img-thumbnail me-2" 
                                                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                                                        <% } %>
                                                                        <div>
                                                                            <div class="fw-bold"><%= producto.nombre %></div>
                                                                            <small class="text-muted">
                                                                                Código: <%= producto.producto ? (producto.producto.codigo || 'N/A') : 'N/A' %>
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td class="text-center"><%= producto.cantidad %></td>
                                                                <td class="text-end">$<%= (producto.precio || 0).toFixed(2) %></td>
                                                                <td class="text-end fw-bold">$<%= ((producto.precio || 0) * (producto.cantidad || 1)).toFixed(2) %></td>
                                                            </tr>
                                                        <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="sticky-top" style="top: 1rem;">
                                                <div class="card mb-3 border-0 shadow-sm">
                                                    <div class="card-header bg-white">
                                                        <h6 class="mb-0">
                                                            <i class="bi bi-receipt me-2"></i>Resumen del pedido
                                                        </h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span>Subtotal:</span>
                                                            <span>$<%= (pedido.total || 0).toFixed(2) %></span>
                                                        </div>
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span>Envío:</span>
                                                            <span class="text-success">Gratis</span>
                                                        </div>
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <span>Método de pago:</span>
                                                            <span class="text-capitalize">
                                                                <% if (pedido.metodoPago === 'visa') { %>
                                                                    <i class="bi bi-credit-card me-1"></i>Visa
                                                                <% } else if (pedido.metodoPago === 'mastercard') { %>
                                                                    <i class="bi bi-credit-card me-1"></i>Mastercard
                                                                <% } else { %>
                                                                    <i class="bi bi-cash-coin me-1"></i>Efectivo
                                                                <% } %>
                                                            </span>
                                                        </div>
                                                        <% if (pedido.factura && pedido.factura.numeroFactura) { %>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span>Factura:</span>
                                                                <span class="text-muted"><%= pedido.factura.numeroFactura %></span>
                                                            </div>
                                                        <% } %>
                                                        <hr>
                                                        <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                                                            <span>Total:</span>
                                                            <span class="text-primary">$<%= (pedido.total || 0).toFixed(2) %></span>
                                                        </div>
                                                        
                                                        <% if (pedido.estado !== 'entregado' && pedido.estado !== 'cancelado') { %>
                                                            <div class="d-grid gap-2">
                                                                <button class="btn btn-success btn-confirmar-entrega" data-pedido-id="<%= pedido._id %>">
                                                                    <i class="bi bi-check-circle me-1"></i>Confirmar entrega
                                                                </button>
                                                                <button class="btn btn-outline-danger btn-cancelar-pedido" data-pedido-id="<%= pedido._id %>">
                                                                    <i class="bi bi-x-circle me-1"></i>Cancelar pedido
                                                                </button>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <i class="bi bi-box-seam display-1 text-muted"></i>
                        </div>
                        <h3 class="text-muted">No tienes pedidos realizados</h3>
                        <p class="text-muted mb-4">¡Comienza a comprar y tus pedidos aparecerán aquí!</p>
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Seguir Comprando
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('./partials/footer.ejs'); %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/JS/user.js"></script>
    <script src="/JS/carrito.js"></script>
    <script src="/JS/animations.js"></script>
    <script>
        // Manejar confirmación de entrega
        document.addEventListener('DOMContentLoaded', function() {
            const botonesConfirmar = document.querySelectorAll('.btn-confirmar-entrega');
            const botonesCancelar = document.querySelectorAll('.btn-cancelar-pedido');
            
            botonesConfirmar.forEach(boton => {
                boton.addEventListener('click', async function() {
                    const pedidoId = this.dataset.pedidoId;
                    
                    const result = await Swal.fire({
                        title: '¿Confirmar entrega?',
                        text: '¿Has recibido tu pedido y deseas confirmarlo como entregado?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#198754',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Sí, confirmar',
                        cancelButtonText: 'Cancelar'
                    });
                    
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/api/pedido/usuario/${pedidoId}`, {
                                method: 'PUT',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ accion: 'confirmar' })
                            });
                            
                            const data = await response.json();
                            
                            if (data.success) {
                                await Swal.fire({
                                    icon: 'success',
                                    title: '¡Éxito!',
                                    text: data.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                window.location.reload();
                            } else {
                                throw new Error(data.message || 'Error al confirmar el pedido');
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: error.message || 'Ocurrió un error al confirmar el pedido'
                            });
                        }
                    }
                });
            });
            
            botonesCancelar.forEach(boton => {
                boton.addEventListener('click', async function() {
                    const pedidoId = this.dataset.pedidoId;
                    
                    const result = await Swal.fire({
                        title: '¿Cancelar pedido?',
                        text: 'Esta acción no se puede deshacer. ¿Estás seguro de cancelar este pedido?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Sí, cancelar',
                        cancelButtonText: 'No, mantener'
                    });
                    
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/api/pedido/usuario/${pedidoId}`, {
                                method: 'PUT',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ accion: 'cancelar' })
                            });
                            
                            const data = await response.json();
                            
                            if (data.success) {
                                await Swal.fire({
                                    icon: 'success',
                                    title: 'Pedido cancelado',
                                    text: data.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                window.location.reload();
                            } else {
                                throw new Error(data.message || 'Error al cancelar el pedido');
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: error.message || 'Ocurrió un error al cancelar el pedido'
                            });
                        }
                    }
                });
            });
        });
    </script>
</body>

</html>