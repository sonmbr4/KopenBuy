<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tienda de tecnología con los mejores productos al mejor precio">
    <title>Kopen Buy - Tecnología de Última Generación</title>
    <link rel="stylesheet" href="/CSS/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>





<body>

    <%- include('../partials/header.ejs'); %>

        <!-- Características específicas de smartphones -->



        <main>

            <h2 class="text-center my-5">Productos de smartphones</h2>

            <section class="py-5 bg-light">
                <div class="container">
                    <h2 class="text-center mb-5">Características importantes en smartphones</h2>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-phone fs-1 text-primary mb-3"></i>
                                <h4>Pantalla</h4>
                                <p>AMOLED o IPS con alta resolución y tasa de refresco.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-camera fs-1 text-primary mb-3"></i>
                                <h4>Cámara</h4>
                                <p>Múltiples lentes y capacidades de fotografía profesional.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-battery-full fs-1 text-primary mb-3"></i>
                                <h4>Batería</h4>
                                <p>4000mAh o más para mayor duración y carga rápida.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!-- Productos -->
            <section class="container mb-5">
                <div class="row g-4">
                    <!-- Producto 1 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/Xiaomi-redmi-smartphones.png" class="card-img-top"
                                alt="Xiaomi Redmi">
                            <div class="card-body">
                                <h5 class="card-title">Xiaomi Redmi Note 14</h5>
                                <p class="card-text">6.67", 128GB, 6GB RAM, Cámara 108MP</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">EN STOCK</span>
                                    <span class="fw-bold">$648.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 2 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/motorola-g55-smartpones.png" class="card-img-top"
                                alt="Motorola G55">
                            <div class="card-body">
                                <h5 class="card-title">Motorola G55</h5>
                                <p class="card-text">256GB, 8GB RAM, Pantalla AMOLED</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">EN STOCK</span>
                                    <span class="fw-bold">$800.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 3 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/SAMSUNG-GALAXY-S25-smartphone.png" class="card-img-top"
                                alt="Samsung Galaxy">
                            <div class="card-body">
                                <h5 class="card-title">Samsung Galaxy S24</h5>
                                <p class="card-text">Dual SIM, 128GB, 8GB RAM</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">EN STOCK</span>
                                    <span class="fw-bold">$2'179.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <%- include('../partials/footer.ejs'); %>
        <script src="/JS/user.js">
    </script>
</body>

</html>