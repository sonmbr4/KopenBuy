<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tienda de tecnología con los mejores productos al mejor precio">
    <title>Kopen Buy - Tecnología de Última Generación</title>
    <link rel="stylesheet" href="/CSS/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <%- include('../partials/header.ejs'); %>

        <main>
            <h2 class="text-center my-5">Productos de laptops</h2>

            <!-- Características -->
            <section class="py-5 bg-light">
                <div class="container">
                    <h2 class="text-center mb-5">¿Qué considerar al comprar una laptop?</h2>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-cpu fs-1 text-primary mb-3"></i>
                                <h4>Procesador</h4>
                                <p>Elige entre Intel Core i3, i5, i7 o AMD Ryzen según tus necesidades de rendimiento.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-memory fs-1 text-primary mb-3"></i>
                                <h4>Memoria RAM</h4>
                                <p>8GB es lo mínimo recomendado para multitarea, 16GB para trabajo profesional.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-hdd fs-1 text-primary mb-3"></i>
                                <h4>Almacenamiento</h4>
                                <p>SSD de 256GB o más para mayor velocidad y capacidad.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!-- Productos -->
            <section class="container mb-5">
                <div class="row g-4">
                    <!-- Producto 1 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/Laptop-Asus-Laptops.png" class="card-img-top" alt="Laptop Asus">
                            <div class="card-body">
                                <h5 class="card-title">Laptop Asus Vivobook</h5>
                                <p class="card-text">Procesador Intel i5, SSD 512GB, Pantalla Full HD</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-warning">CASI AGOTADO</span>
                                    <span class="fw-bold">$2'250.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 2 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/laptop-hp-laptops.png" class="card-img-top" alt="Laptop HP">
                            <div class="card-body">
                                <h5 class="card-title">Notebook HP 15.6"</h5>
                                <p class="card-text">Intel Celeron, 8GB RAM, SSD 256GB</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">EN STOCK</span>
                                    <span class="fw-bold">$810.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 3 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/Lenovo-laptops.png" class="card-img-top" alt="Laptop Lenovo">
                            <div class="card-body">
                                <h5 class="card-title">Lenovo V14 G3</h5>
                                <p class="card-text">Core i7, 16GB RAM, SSD 512GB</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">EN STOCK</span>
                                    <span class="fw-bold">$2'500.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 4 -->
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card product-card h-100">
                            <img src="assests/imagenes/Laptop-Gamer-Carousel.png" class="card-img-top"
                                alt="Laptop Gamer">
                            <div class="card-body">
                                <h5 class="card-title">Laptop Gamer Avanzada</h5>
                                <p class="card-text">RTX 3060, Intel i7, 16GB RAM</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">EN STOCK</span>
                                    <span class="fw-bold">$3'750.000</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100">Ver Detalles</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


        </main>

        <%- include('../partials/footer.ejs'); %>
</body>

</html>