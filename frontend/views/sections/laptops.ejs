<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tienda de tecnología con los mejores productos al mejor precio">
    <title>Kopen Buy - Tecnología de Última Generación</title>
    <link rel="stylesheet" href="/CSS/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <%- include('../partials/header.ejs'); %>

        <main>
            <h2 class="text-center my-5">Productos de laptops</h2>

            <!-- Características -->
            <section class="py-5 bg-light">
                <div class="container">
                    <h2 class="text-center mb-5">¿Qué considerar al comprar una laptop?</h2>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-cpu fs-1 text-primary mb-3"></i>
                                <h4>Procesador</h4>
                                <p>Elige entre Intel Core i3, i5, i7 o AMD Ryzen según tus necesidades de rendimiento.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-memory fs-1 text-primary mb-3"></i>
                                <h4>Memoria RAM</h4>
                                <p>8GB es lo mínimo recomendado para multitarea, 16GB para trabajo profesional.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="bi bi-hdd fs-1 text-primary mb-3"></i>
                                <h4>Almacenamiento</h4>
                                <p>SSD de 256GB o más para mayor velocidad y capacidad.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!-- Productos -->
            <section class="py-5 product-section">
                <div class="container">
                    <h2 class="text-center mb-5 fade-in-scroll" id="laptops">Computadoras</h2>
                    <div class="row g-4">
                        <% if (productosComputadora && productosComputadora.length> 0) { %>
                            <% productosComputadora.forEach((producto, index)=> { %>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card product-card fade-in-scroll"
                                        style="transition-delay: <%= 0.1 * (index + 1) %>s;">
                                        <% if (producto.image) { %>
                                            <img src="<%= producto.image %>" class="card-img-top product-image"
                                                alt="<%= producto.name %>" loading="lazy">
                                            <% } else { %>
                                                <img src="/images/placeholder-product.jpg"
                                                    class="card-img-top product-image" alt="Imagen no disponible"
                                                    loading="lazy">
                                                <% } %>
                                                    <div class="card-body">
                                                        <h5 class="card-title">
                                                            <%= producto.name %>
                                                        </h5>
                                                        <% if (producto.category) { %>
                                                            <p class="text-primary mb-2"><small>
                                                                    <%= producto.category %>
                                                                </small></p>
                                                            <% } %>
                                                                <p class="card-text text-muted">
                                                                    <%= producto.description
                                                                        || 'Sin descripción disponible' %>
                                                                </p>
                                                                <div
                                                                    class="d-flex justify-content-between align-items-center">
                                                                    <span
                                                                        class="badge <%= producto.stock <= 0 ? 'bg-danger' : (producto.stock < 10 ? 'bg-warning' : 'bg-success') %>">
                                                                        <%= producto.stock <=0 ? 'Agotado' :
                                                                            (producto.stock < 10 ? 'Casi Agotado'
                                                                            : 'En Stock' ) %>
                                                                    </span>
                                                                    <span class="fw-bold">$<%= producto.price ?
                                                                            producto.price.toLocaleString() : '0' %>
                                                                    </span>
                                                                </div>
                                                    </div>
                                                    <div class="card-footer bg-white border-0 d-flex flex-column gap-2">
                                                        <button class="btn btn-outline-primary w-100">Ver
                                                            Detalles</button>
                                                        <button class="btn btn-success add-to-cart-btn auth-only"
                                                            style="display: none;" data-product-id="<%= producto._id %>">🛒 Agregar al Carrito</button>
                                                    </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="col-12 text-center">
                                            <p>No hay computadoras disponibles en este momento.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </section>


        </main>

        <%- include('../partials/footer.ejs'); %>
        
        <!-- Scripts -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/JS/user.js"></script>
        <script src="/JS/carrito.js"></script>
        <script src="/JS/animations.js"></script>
</body>

</html>