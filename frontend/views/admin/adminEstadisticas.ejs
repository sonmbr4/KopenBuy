<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Panel de administración de Kopen Buy - Estadísticas de ventas">
    <title>Panel de Administración - Estadísticas | Kopen Buy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/CSS/admin.css">
</head>

<body class="bg-light">
    <header class="admin-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <button class="btn btn-link d-md-none me-2 text-white" id="sidebarToggle">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-bag-check me-2"></i>Kopen Buy Admin
                </a>
                <div class="d-flex align-items-center ms-auto">
                    <div class="dropdown">
                        <a href="/" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                            id="userDropdown" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-2 fs-5"></i>
                            <span>Administrador</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a href="#" onclick="configuracion()" class="dropdown-item" data-bs-toggle="offcanvas"
                                    data-bs-target="#profileConfigOffcanvas">
                                    <i class="bi bi-gear me-2"></i> Configuración
                                </a>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><button id="logout-btn" onclick="logout()" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-2 col-md-3 sidebar p-0" id="sidebar">
                <div class="text-center p-4 border-bottom">
                    <i class="bi bi-person-circle fs-1 text-success"></i>
                    <h5 class="mt-2 mb-1">Administrador</h5>
                    <small class="text-muted">admin@kopenbuy.com</small>
                </div>
                <div class="list-group list-group-flush rounded-0">
                    <a href="/admin/productos" class="list-group-item list-group-item-action">
                        <i class="bi bi-boxes me-2"></i> Productos
                    </a>
                    <a href="/admin/pedidos" class="list-group-item list-group-item-action">
                        <i class="bi bi-cart me-2"></i> Pedidos
                    </a>
                    <a href="/admin/clientes" class="list-group-item list-group-item-action">
                        <i class="bi bi-people me-2"></i> Clientes
                    </a>
                    <a href="/admin/estadisticas" class="list-group-item list-group-item-action active">
                        <i class="bi bi-graph-up me-2"></i> Estadísticas
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-10 col-md-9 ms-sm-auto px-md-4 py-4 main-content" id="mainContent">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h2 class="h3 fw-bold text-success">
                        <i class="bi bi-graph-up me-2"></i>Estadísticas de Ventas
                    </h2>
                </div>

                <!-- Estadísticas principales -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card shadow-sm text-center">
                            <div class="card-body">
                                <i class="bi bi-currency-dollar fs-2 text-success mb-2"></i>
                                <h5 class="card-title mb-1">Ingresos Totales</h5>
                                <p class="card-text fs-4 fw-bold">
                                    $<%= estadisticas.ingresosTotales ? estadisticas.ingresosTotales.toFixed(2) : '0.00' %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card shadow-sm text-center">
                            <div class="card-body">
                                <i class="bi bi-cart-check fs-2 text-primary mb-2"></i>
                                <h5 class="card-title mb-1">Ventas Totales</h5>
                                <p class="card-text fs-4 fw-bold">
                                    <%= estadisticas.totalVentas || 0 %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card shadow-sm text-center">
                            <div class="card-body">
                                <i class="bi bi-people fs-2 text-info mb-2"></i>
                                <h5 class="card-title mb-1">Clientes Registrados</h5>
                                <p class="card-text fs-4 fw-bold">
                                    <%= estadisticas.totalUsuarios || 0 %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card shadow-sm text-center">
                            <div class="card-body">
                                <i class="bi bi-box-seam fs-2 text-warning mb-2"></i>
                                <h5 class="card-title mb-1">Productos Registrados</h5>
                                <p class="card-text fs-4 fw-bold">
                                    <%= estadisticas.totalProductos || 0 %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gráfico de ventas mensuales -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="bi bi-bar-chart-line me-2"></i>Ventas Mensuales
                    </div>
                    <div class="card-body">
                        <canvas id="ventasMensualesChart" height="80"></canvas>
                    </div>
                </div>

                <!-- Productos más vendidos -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-star me-2"></i>Productos Más Vendidos
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Producto</th>
                                        <th>Cantidad Vendida</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (estadisticas.productosMasVendidos && estadisticas.productosMasVendidos.length > 0) { %>
                                        <% estadisticas.productosMasVendidos.forEach((prod, idx) => { %>
                                            <tr>
                                                <td><%= idx + 1 %></td>
                                                <td>
                                                    <%= prod.nombre || 'Nombre no disponible' %>
                                                </td>
                                                <td><%= prod.cantidadVendida %></td>
                                            </tr>
                                        <% }) %>
                                    <%  } else { %>
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">No hay datos disponibles.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ...puedes agregar más estadísticas aquí... -->
            </div>
        </div>
    </div>

    <footer class="footer bg-dark text-white py-4 mt-4">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="mb-3"><i class="bi bi-bag-check text-success me-2"></i>Kopen Buy Admin</h5>
                    <p class="mb-0 text-white-50">Panel de administración para la tienda de tecnología Kopen Buy</p>
                </div>
                <div class="col-md-3">
                    <h5 class="mb-3">Enlaces</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="PaginaPrincipal.html" class="text-white-50 text-decoration-none"><i
                                    class="bi bi-arrow-right-short text-success"></i> Tienda Principal</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none"><i
                                    class="bi bi-arrow-right-short text-success"></i> Documentación</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5 class="mb-3">Soporte</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-envelope text-success me-2"></i> soporte@kopenbuy.com</li>
                        <li class="mb-2"><i class="bi bi-telephone text-success me-2"></i> +123 456 7890</li>
                    </ul>
                </div>
            </div>
            <hr class="my-4 bg-success bg-opacity-25">
            <div class="text-center">
                <p class="mb-0 small text-white-50">&copy; 2025 Kopen Buy. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
    // Gráfico de ventas mensuales
    const ctx = document.getElementById('ventasMensualesChart').getContext('2d');
    // Inyectar datos del backend como objeto JS
    const ventasMensuales = <%- JSON.stringify(estadisticas.ventasPorMes || []) %>; 
    const meses = ventasMensuales.map(function(v) { return v.mes; });
    const ventas = ventasMensuales.map(function(v) { return v.total; });

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: meses,
            datasets: [{
                label: 'Ventas',
                data: ventas,
                backgroundColor: 'rgba(40, 167, 69, 0.7)'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
<script src="/JS/adminClient.js"></script>

</body>

</html>