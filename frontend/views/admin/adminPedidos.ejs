<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Panel de administración de Kopen Buy - Gestión de pedidos">
    <title>Panel de Administración - Pedidos | Kopen Buy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/CSS/admin.css">
</head>

<body class="bg-light">
    <header class="admin-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <button class="btn btn-link d-md-none me-2 text-white" id="sidebarToggle">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-bag-check me-2"></i>Kopen Buy Admin
                </a>
                <div class="d-flex align-items-center ms-auto">
                    <div class="dropdown">
                        <a href="/" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                            id="userDropdown" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-2 fs-5"></i>
                            <span>Administrador</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a href="#" onclick="configuracion()" class="dropdown-item" data-bs-toggle="offcanvas"
                                    >
                                    <i class="bi bi-gear me-2"></i> Configuración
                                </a>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><button id="logout-btn" onclick="logout()" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-2 col-md-3 sidebar p-0" id="sidebar">
                <div class="text-center p-4 border-bottom">
                    <i class="bi bi-person-circle fs-1 text-success"></i>
                    <h5 class="mt-2 mb-1"><%= user.name %></h5>
                    <small class="text-muted"><%= user.email %></small>
                </div>
                <div class="list-group list-group-flush rounded-0">
                    <a href="/admin/productos" class="list-group-item list-group-item-action">
                        <i class="bi bi-boxes me-2"></i> Productos
                    </a>
                    <a href="/admin/pedidos" class="list-group-item list-group-item-action active">
                        <i class="bi bi-cart me-2"></i> Pedidos
                    </a>
                    <a href="/admin/clientes" class="list-group-item list-group-item-action">
                        <i class="bi bi-people me-2"></i> Clientes
                    </a>
                    <a href="/admin/estadisticas" class="list-group-item list-group-item-action">
                        <i class="bi bi-graph-up me-2"></i> Estadísticas
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-10 col-md-9 ms-sm-auto px-md-4 py-4 main-content" id="mainContent">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h2 class="h3 fw-bold section-title-pedidos">
                        <i class="bi bi-cart me-2"></i>Gestión de Pedidos
                    </h2>
                </div>

                <div class="row">
                    <% if (allOrders && allOrders.length > 0) { %>
                        <% allOrders.forEach(function(order) { %>
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 border-0 shadow-sm">
                                    <% 
                                    // Definir clases y textos para los estados
                                    const statusClass = {
                                        'pendiente': 'bg-secondary',  // Gris para pendiente
                                        'confirmado': 'bg-primary',   // Azul para confirmado
                                        'enviado': 'bg-warning',      // Amarillo para enviado
                                        'entregado': 'bg-success',    // Verde para entregado
                                        'cancelado': 'bg-danger'      // Rojo para cancelado
                                    };
                                    const statusText = {
                                        'pendiente': 'Pendiente',
                                        'confirmado': 'Confirmado',
                                        'enviado': 'Enviado',
                                        'entregado': 'Entregado',
                                        'cancelado': 'Cancelado'
                                    }; 
                                    
                                    // Obtener la clase y texto del estado actual
                                    const currentStatus = order.status || 'pendiente';
                                    const headerClass = statusClass[currentStatus] || 'bg-secondary';
                                    const statusDisplay = statusText[currentStatus] || currentStatus;
                                    %>
                                    <div class="card-header d-flex justify-content-between align-items-center <%= headerClass %> text-white">
                                        <div class="d-flex align-items-center w-100 justify-content-between">
                                            <h5 class="mb-0 me-2">Pedido #<%= order.id %></h5>
                                            <div class="d-flex align-items-center">
                                                <span class="badge <%= headerClass %> me-2"><%= statusDisplay %></span>
                                                <select class="form-select form-select-sm status-select" data-order-id="<%= order.id %>" style="max-width: 150px;">
                                                    <option value="pendiente" <%= currentStatus === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                                                    <option value="confirmado" <%= currentStatus === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                                                    <option value="enviado" <%= currentStatus === 'enviado' ? 'selected' : '' %>>Enviado</option>
                                                    <option value="entregado" <%= currentStatus === 'entregado' ? 'selected' : '' %>>Entregado</option>
                                                    <option value="cancelado" <%= currentStatus === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <h6 class="text-muted">Cliente</h6>
                                            <p><%= order.customer %></p>
                                        </div>
                                        <% if (order.date) { %>
                                        <div class="mb-3">
                                            <h6 class="text-muted">Fecha</h6>
                                            <p><%= new Date(order.date).toLocaleDateString() %></p>
                                        </div>
                                        <% } %>
                                        <% if (order.products && order.products.length > 0) { %>
                                        <div class="mb-3">
                                            <h6 class="text-muted">Productos</h6>
                                            <ul class="list-group list-group-flush">
                                                <% order.products.forEach(function(product) { %>
                                                    <li class="list-group-item d-flex justify-content-between px-0">
                                                        <span><%= product.nombre || 'Producto sin nombre' %> x<%= product.cantidad || 1 %></span>
                                                        <span>$<%= (product.precio || 0).toLocaleString('es-CO') %></span>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                        <% } %>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">Total</h5>
                                            <h5 class="mb-0 text-success">$<%= (order.total || 0).toLocaleString('es-CO') %></h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-12">
                            <div class="alert alert-info">No hay pedidos para mostrar.</div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer mt-auto py-3 bg-dark text-white">
        <div class="container text-center">
            <p class="mb-0 small text-white-50">&copy; 2025 Kopen Buy. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/JS/modalsAdmin.js"></script>
    <script>
        // Manejar el cambio de estado del pedido
        document.addEventListener('DOMContentLoaded', function() {
            const statusSelects = document.querySelectorAll('.status-select');
            
            // Función para actualizar los colores basados en el estado
            function updateStatusColors() {
                statusSelects.forEach(select => {
                    const status = select.value;
                    const cardHeader = select.closest('.card').querySelector('.card-header');
                    const statusBadge = select.previousElementSibling;
                    
                    // Actualizar clases del encabezado
                    cardHeader.className = cardHeader.className.split(' ').filter(c => !c.startsWith('bg-')).join(' ');
                    cardHeader.classList.add(
                        status === 'pendiente' ? 'bg-secondary' : 
                        status === 'confirmado' ? 'bg-primary' :
                        status === 'enviado' ? 'bg-warning' :
                        status === 'entregado' ? 'bg-success' : 'bg-danger',
                        'text-white', 'd-flex', 'justify-content-between', 'align-items-center'
                    );
                    
                    // Actualizar badge
                    statusBadge.className = 'badge ' + 
                        (status === 'pendiente' ? 'bg-secondary' : 
                         status === 'confirmado' ? 'bg-primary' :
                         status === 'enviado' ? 'bg-warning' :
                         status === 'entregado' ? 'bg-success' : 'bg-danger') + ' me-2';
                    
                    statusBadge.textContent = status.charAt(0).toUpperCase() + status.slice(1);
                });
            }
            
            // Inicializar colores al cargar la página
            updateStatusColors();
            
            statusSelects.forEach(select => {
                // Guardar el valor inicial
                select._x = select.value;
                
                select.addEventListener('change', async function() {
                    const orderId = this.dataset.orderId;
                    const newStatus = this.value;
                    const originalStatus = this._x;
                    
                    try {
                        const response = await fetch(`/api/pedido/${orderId}`, {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-api-key': 'APIKEY_PEDIDO_456'
                            },
                            body: JSON.stringify({ estado: newStatus })
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            // Actualizar el valor guardado
                            this._x = newStatus;
                            
                            // Actualizar colores
                            updateStatusColors();
                            
                            // Mostrar notificación de éxito
                            Swal.fire({
                                icon: 'success',
                                title: '¡Éxito!',
                                text: 'Estado del pedido actualizado correctamente',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000
                            });
                            
                            // Recargar la página después de 1 segundo para asegurar que todo esté actualizado
                            setTimeout(() => {
                                window.location.reload();
                            }, 1000);
                            
                        } else {
                            throw new Error(result.message || 'Error al actualizar el estado del pedido');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        // Revertir el cambio en el select
                        this.value = originalStatus;
                        
                        // Mostrar notificación de error
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: error.message || 'Ocurrió un error al actualizar el estado del pedido',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 3000
                        });
                    }
                });
            });
        });
    </script>
</body>