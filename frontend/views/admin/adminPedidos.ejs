<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Panel de administración de Kopen Buy - Gestión de pedidos">
    <title>Panel de Administración - Pedidos | Kopen Buy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/CSS/admin.css">
</head>

<body class="bg-light">
    <header class="admin-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <button class="btn btn-link d-md-none me-2 text-white" id="sidebarToggle">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-bag-check me-2"></i>Kopen Buy Admin
                </a>
                <div class="d-flex align-items-center ms-auto">
                    <div class="dropdown">
                        <a href="/" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                            id="userDropdown" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-2 fs-5"></i>
                            <span>Administrador</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a href="#" onclick="configuracion()" class="dropdown-item" data-bs-toggle="offcanvas"
                                    >
                                    <i class="bi bi-gear me-2"></i> Configuración
                                </a>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><button id="logout-btn" onclick="logout()" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-2 col-md-3 sidebar p-0" id="sidebar">
                <div class="text-center p-4 border-bottom">
                    <i class="bi bi-person-circle fs-1 text-success"></i>
                    <h5 class="mt-2 mb-1">Administrador</h5>
                    <small class="text-muted">admin@kopenbuy.com</small>
                </div>
                <div class="list-group list-group-flush rounded-0">
                    <a href="/admin/productos" class="list-group-item list-group-item-action">
                        <i class="bi bi-boxes me-2"></i> Productos
                    </a>
                    <a href="/admin/pedidos" class="list-group-item list-group-item-action active">
                        <i class="bi bi-cart me-2"></i> Pedidos
                    </a>
                    <a href="/admin/clientes" class="list-group-item list-group-item-action">
                        <i class="bi bi-people me-2"></i> Clientes
                    </a>
                    <a href="/admin/estadisticas" class="list-group-item list-group-item-action">
                        <i class="bi bi-graph-up me-2"></i> Estadísticas
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-10 col-md-9 ms-sm-auto px-md-4 py-4 main-content" id="mainContent">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h2 class="h3 fw-bold section-title-pedidos">
                        <i class="bi bi-cart me-2"></i>Gestión de Pedidos
                    </h2>
                </div>

                <div class="row">
                    <% if (allOrders && allOrders.length > 0) { %>
                        <% allOrders.forEach(function(order) { %>
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header d-flex justify-content-between align-items-center 
                                        <%= order.status === 'delivered' ? 'bg-success' : (order.status === 'shipped' ? 'bg-warning' : 'bg-secondary') %> text-white">
                                        <h5 class="mb-0">Pedido #<%= order.id %></h5>
                                        <span class="badge bg-white text-dark">
                                            <%= order.status === 'delivered' ? 'Entregado' : (order.status === 'shipped' ? 'En camino' : 'Pendiente') %>
                                        </span>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <h6 class="text-muted">Cliente</h6>
                                            <p><%= order.customer %></p>
                                        </div>
                                        <div class="mb-3">
                                            <h6 class="text-muted">Fecha</h6>
                                            <p><%= order.date %></p>
                                        </div>
                                        <div class="mb-3">
                                            <h6 class="text-muted">Productos</h6>
                                            <ul class="list-group list-group-flush">
                                                <% order.products.forEach(function(product) { %>
                                                    <li class="list-group-item d-flex justify-content-between px-0">
                                                        <span><%= product.name %> x<%= product.quantity %></span>
                                                        <span>$<%= product.price.toLocaleString('es-CO') %></span>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">Total</h5>
                                            <h5 class="mb-0">$<%= order.total.toLocaleString('es-CO') %></h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-12">
                            <div class="alert alert-info text-center">
                                No hay pedidos disponibles en este momento.  
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer bg-dark text-white py-4 mt-4">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="mb-3"><i class="bi bi-bag-check text-success me-2"></i>Kopen Buy Admin</h5>
                    <p class="mb-0 text-white-50">Panel de administración para la tienda de tecnología Kopen Buy</p>
                </div>
                <div class="col-md-3">
                    <h5 class="mb-3">Enlaces</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/" class="text-white-50 text-decoration-none"><i
                                    class="bi bi-arrow-right-short text-success"></i> Tienda Principal</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none"><i
                                    class="bi bi-arrow-right-short text-success"></i> Documentación</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5 class="mb-3">Soporte</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-envelope text-success me-2"></i> soporte@kopenbuy.com</li>
                        <li class="mb-2"><i class="bi bi-telephone text-success me-2"></i> +123 456 7890</li>
                    </ul>
                </div>
            </div>
            <hr class="my-4 bg-success bg-opacity-25">
            <div class="text-center">
                <p class="mb-0 small text-white-50">&copy; 2025 Kopen Buy. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/JS/modalsAdmin.js"></script>
    <script src="/JS/adminClient.js"></script>
</body>

</html>