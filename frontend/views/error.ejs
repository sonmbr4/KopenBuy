<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Tienda de Tecnología</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Orbitron:wght@500;700&display=swap">
    <style>
        :root {
            --primary-color: #28a745;       /* Verde del botón de "oferta" */
            --secondary-color: #212529;     /* Negro/gris oscuro */
            --bg-color: #f8f9fa;            /* Gris claro del fondo */
            --text-color: #333;             /* Texto principal */
            --font-main: 'Poppins', sans-serif;
            --font-accent: 'Orbitron', sans-serif; /* Fuente para los números */
        }

        body {
            font-family: var(--font-main);
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
            overflow: hidden;
            position: relative;
        }

        /* Efecto de fondo sutil con gradiente */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(40, 167, 69, 0.1) 0%, rgba(248, 249, 250, 0) 70%);
            animation: pulse-glow 10s ease-in-out infinite;
        }

        @keyframes pulse-glow {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        .error-container {
            max-width: 600px;
            position: relative;
            z-index: 10;
            background-color: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
            border-top: 5px solid var(--primary-color);
            transform: translateY(-20px);
            opacity: 0;
            animation: slide-in 0.8s forwards ease-out;
        }

        @keyframes slide-in {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .error-code {
            font-family: var(--font-accent);
            font-size: 8rem;
            font-weight: 700;
            color: var(--secondary-color);
            margin: 0;
            line-height: 1;
            letter-spacing: -3px;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
        }

        .error-message {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--secondary-color);
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .error-description {
            font-size: 1.1rem;
            color: var(--text-color);
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .btn-home {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary-color), #218838);
            color: #fff;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(40, 167, 69, 0.3);
        }

        .btn-home:hover {
            background: linear-gradient(135deg, #218838, var(--primary-color));
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.4);
        }
    </style>
</head>
<body>
    <div class="error-container">
        <% if (errorCode) { %>
            <h1 class="error-code"><%= errorCode %></h1>
        <% } %>
        <h2 class="error-message">¡Error de Conexión!</h2>
        <% if (errorMessage) { %>
            <p class="error-description"><%= errorMessage %></p>
        <% } else { %>
            <p class="error-description">Parece que la página que buscas no existe o ha ocurrido un problema con la conexión. Te invitamos a volver a la página principal para continuar navegando.</p>
        <% } %>
        <a href="/landing" class="btn-home">Volver a la Página Principal</a>
    </div>
</body>
</html>